# ==============================================================================
# DocSentry Environment Configuration (Placeholders only — Never commit secrets)
# ==============================================================================

# Application Environment Mode (development, test, production)
DOCSENTRY_ENV=development

# Database Connection URL
# SQLite default for instant zero-dependency local development:
DOCSENTRY_DATABASE_URL=sqlite:///./docsentry.db
# PostgreSQL for production/Docker:
# DOCSENTRY_DATABASE_URL=postgresql+psycopg://docsentry:docsentry_secret@localhost:5432/docsentry_prod

# JWT & Authentication Secret Key
DOCSENTRY_SECRET_KEY=replace-with-a-secure-random-64-character-hex-secret-in-production

# GitHub App Integration Credentials (Optional in local development)
DOCSENTRY_GITHUB_CLIENT_ID=
DOCSENTRY_GITHUB_CLIENT_SECRET=
DOCSENTRY_GITHUB_WEBHOOK_SECRET=
DOCSENTRY_GITHUB_APP_ID=
DOCSENTRY_GITHUB_PRIVATE_KEY=

# Ollama / Semantic Reasoning Model Setup (Track A Core Intelligence)
DOCGUARD_MODEL_ENABLED=true
DOCGUARD_MODEL_PROVIDER=ollama
DOCGUARD_MODEL_BASE_URL=http://localhost:11434
DOCGUARD_MODEL_NAME=qwen3:8b
DOCGUARD_MODEL_TIMEOUT_SECONDS=60
DOCGUARD_MODEL_API_KEY=
